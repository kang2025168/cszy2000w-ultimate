DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=tradebot
DB_PASS=CHANGE_ME
DB_NAME=cszy2000

GETDATA_TABLE=stock_prices_pool
SYMBOLS_CSV=/app/data/us_listed_company_symbols.csv

MAX_TICKERS=50
BATCH_SIZE=80

LOG_DIR=/app/logs

# Ultimate V1 资金池、风控、持仓展示系统
CAPITAL_MODE=NORMAL
ENABLE_CAPITAL_MANAGER=1
ENABLE_RISK_CONTROLLER=1
ENABLE_POSITION_HOLDINGS=1
POSITION_SYNC_ON_START=1
POSITION_SYNC_INTERVAL_SEC=300

# A is a separate retirement account. B/C/D share the margin account at 4:4:2.
A_ACCOUNT_CAPITAL_PCT=1.0
B_ACCOUNT_CAPITAL_PCT=0.4
C_ACCOUNT_CAPITAL_PCT=0.4
D_ACCOUNT_CAPITAL_PCT=0.2

# C 长期核心仓自动建仓：仅使用 C 资金池现金，分层按目标权重补缺口。
C_CORE_AUTO_BUY_ENABLED=0
C_CORE_AUTO_BUY_DRY_RUN=0
C_CORE_MIN_ORDER_USD=25
C_CORE_DAILY_BUDGET_PCT=1.0
C_CORE_DAILY_BUDGET_MAX_USD=0
C_CORE_CASH_RESERVE_USD=25
C_CORE_MAX_ORDERS_PER_RUN=3
C_CORE_TIER_FILL_RATIO=0.90
C_CORE_FILL_WAIT_SEC=8

# A 养老金账户做 T：整个账户每天最多启动 1 轮；设为 0 可完全关闭 A 做 T。
# 已启动轮次的第二腿不受该上限阻止，以便恢复核心仓。
A_T_MAX_CYCLES_PER_DAY=1

DAILY_LOSS_LIMIT_PCT=0.03
MAX_LOSS_DAYS=3
MAX_DRAWDOWN_PCT=0.08
RISK_BROKER_PROFILE=trading
# 相邻交易日权益跳变达到该比例时，视为入出金/账户切换并重建回撤基准。
RISK_EQUITY_RESET_RATIO=0.35
B_KEEP_TRADING_DAYS=5
B_ARCHIVE_TABLE=stock_operations_b_archive
DEFAULT_RISK_MULTIPLIER=1.0
MIN_RISK_MULTIPLIER=0.0
MAX_RISK_MULTIPLIER=1.0

ENABLE_D_INTRADAY=1
D_USE_MARGIN=1
MARKET_CLOSE_FLATTEN_TIME=12:50
TIMEZONE=America/Los_Angeles

ULTIMATE_WEB_HOST=0.0.0.0
ULTIMATE_WEB_PORT=8060
ULTIMATE_EXTERNAL_BOTS=b_buy_bot,b_sell_bot,f_buy_bot,f_sell_bot
DASHBOARD_LOGIN_PASSWORD=CHANGE_ME
DASHBOARD_AUTH_SECRET=CHANGE_ME_RANDOM_SECRET
MOBILE_CONTROL_TOKEN=CHANGE_ME_RANDOM_SECRET

# V1 临时风险指标：后续接入账户历史、VIX、趋势数据后，可以替换为自动计算。
RISK_DAILY_PNL_PCT=0.0
RISK_LOSS_DAYS=0
RISK_MAX_DRAWDOWN_PCT=0.0
# Strategy D single-cycle intraday grid. Keep disabled and simulated until verified.
D_GRID_ENABLED=0
D_GRID_DRY_RUN=1
D_GRID_DEFAULT_NOTIONAL_USD=250
D_GRID_USE_AVAILABLE_CAPITAL=1
D_GRID_MAX_CYCLE_NOTIONAL_USD=10000
D_GRID_ENTRY_PCT=0.0025
D_GRID_PROFIT_PCT=0.01
D_GRID_MAX_SPREAD=0.05
D_GRID_BUY_TIMEOUT_SEC=45
D_GRID_COOLDOWN_SEC=5
D_GRID_OPEN_TIME_LA=06:35
D_GRID_LAST_ENTRY_TIME_LA=12:30
D_GRID_FLATTEN_TIME_LA=12:50
D_AUTO_SELECT_ENABLED=1
D_AUTO_SELECT_INTERVAL_SEC=3600
D_CANDIDATE_MIN_GAIN_PCT=0.05
D_CANDIDATE_MIN_PRICE=5
D_CANDIDATE_MIN_VOLUME=3000000
D_CANDIDATE_MIN_DOLLAR_VOLUME=30000000
D_CANDIDATE_MIN_AVG_RANGE_PCT=0.015
D_CANDIDATE_MAX_AVG_RANGE_PCT=0.04
D_CANDIDATE_LOOKBACK_CALENDAR_DAYS=60
D_CANDIDATE_RETAIN_TRADING_DAYS=2
